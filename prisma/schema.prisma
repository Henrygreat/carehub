generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  ORG_ADMIN
  MANAGER
  COORDINATOR
  CARE_WORKER
}

// Phase 5: Multi-Organisation and Multi-Branch Enums

enum OrganisationStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

// Phase 6: Hybrid Onboarding Enums

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum OnboardingStatus {
  INVITED
  IN_PROGRESS
  READY_FOR_ACTIVATION
  ACTIVE
  BLOCKED
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  ZERO_HOURS
  CONTRACTOR
  TEMPORARY
}

// Phase 2: Care Management Enums

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum VisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
}

enum ShiftStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

// Phase 3: Care Delivery Operations Enums

enum CarePlanStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  ARCHIVED
}

enum TaskFrequency {
  EVERY_VISIT
  DAILY
  WEEKLY
  MONTHLY
  AS_NEEDED
}

enum IncidentCategory {
  FALL
  MEDICATION_ERROR
  SAFEGUARDING
  BEHAVIOR
  EQUIPMENT
  MISSED_CARE
  HEALTH_CONCERN
  PROPERTY_DAMAGE
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

// Phase 4: Scheduling and Workforce Management Enums

enum AbsenceType {
  ANNUAL_LEAVE
  SICK_LEAVE
  UNPAID_LEAVE
  COMPASSIONATE
  MATERNITY
  PATERNITY
  UNAVAILABLE
  OTHER
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationType {
  ASSIGNMENT_NEW
  ASSIGNMENT_CHANGED
  ASSIGNMENT_CANCELLED
  VISIT_UPCOMING
  VISIT_MISSED
  VISIT_UNASSIGNED
  LEAVE_REQUESTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  CONFLICT_DETECTED
  GENERAL
}

enum ConflictType {
  OVERLAP
  DOUBLE_BOOKED
  DURING_LEAVE
  OUTSIDE_AVAILABILITY
  INSUFFICIENT_TRAVEL_TIME
  EXCEEDS_HOURS
}

model Organisation {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String
  slug                    String                   @unique
  brandName               String?
  brandColour             String                   @default("#0f766e")
  // Phase 5: Extended organisation fields
  status                  OrganisationStatus       @default(ACTIVE)
  tradingName             String?
  companyRegistrationNo   String?
  contactEmail            String?
  contactPhone            String?
  registeredAddressLine1  String?
  registeredAddressLine2  String?
  registeredCity          String?
  registeredPostcode      String?
  registeredCountry       String?                  @default("United Kingdom")
  operatingAddressLine1   String?
  operatingAddressLine2   String?
  operatingCity           String?
  operatingPostcode       String?
  operatingCountry        String?                  @default("United Kingdom")
  // CQC regulatory fields (optional - not all providers registered with CQC)
  cqcProviderId           String?
  cqcProviderName         String?
  cqcRegisteredManager    String?
  // Operational settings
  timezone                String                   @default("Europe/London")
  // Timestamps
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  suspendedAt             DateTime?
  // Relations
  memberships             Membership[]
  staffProfiles           StaffProfile[]
  employment              EmploymentRecord[]
  invitations             Invitation[]
  auditLogs               AuditLog[]
  clients                 Client[]
  careVisits              CareVisit[]
  shifts                  Shift[]
  careNotes               CareNote[]
  // Phase 3
  carePlans               CarePlan[]
  incidents               Incident[]
  // Phase 4
  notifications           Notification[]
  travelTimeEstimates     TravelTimeEstimate[]
  // Phase 5: Branches
  branches                Branch[]
  organisationInvitations OrganisationInvitation[]
  // Phase 6: Onboarding
  applications            OrganisationApplication[]
  onboarding              OrganisationOnboarding?
  // Phase 7: Pilot Feedback
  pilotFeedback           PilotFeedback[]

  @@map("organisations")
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  name                    String
  email                   String                   @unique
  passwordHash            String
  emailVerified           DateTime?
  disabledAt              DateTime?
  sessionVersion          Int                      @default(0)
  // Phase 5: Platform admin flag
  isPlatformAdmin         Boolean                  @default(false)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  memberships             Membership[]
  passwordResetTokens     PasswordResetToken[]
  auditEvents             AuditLog[]
  // Phase 5: Platform admin relations
  organisationInvitations OrganisationInvitation[]
  platformAuditLogs       PlatformAuditLog[]
  // Phase 6: Application reviews
  reviewedApplications    OrganisationApplication[]
  // Phase 7: Pilot Feedback
  submittedFeedback       PilotFeedback[]           @relation("FeedbackSubmitter")
  resolvedFeedback        PilotFeedback[]           @relation("FeedbackResolver")

  @@map("users")
}

model Membership {
  id                  String                @id @default(uuid()) @db.Uuid
  userId              String                @db.Uuid
  organisationId      String                @db.Uuid
  role                Role
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation        Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  staffProfiles       StaffProfile[]        @relation("StaffMembership")
  sentInvitations     Invitation[]          @relation("InvitedBy")
  auditLogs           AuditLog[]
  careNotes           CareNote[]
  // Phase 3
  taskCompletions     VisitTaskCompletion[]
  reportedIncidents   Incident[]            @relation("IncidentReporter")
  reviewingIncidents  Incident[]            @relation("IncidentReviewer")
  // Phase 4
  notifications       Notification[]
  reviewedAbsences    StaffAbsence[]        @relation("AbsenceReviewer")
  schedulingOverrides SchedulingOverride[]

  @@unique([userId, organisationId])
  @@unique([id, organisationId])
  @@index([organisationId, role, active])
  @@map("memberships")
}

model StaffProfile {
  id                    String               @id @default(uuid()) @db.Uuid
  organisationId        String               @db.Uuid
  membershipUserId      String?              @db.Uuid
  employeeNumber        String
  firstName             String
  lastName              String
  email                 String
  phone                 String?
  employmentStatus      EmploymentStatus     @default(ACTIVE)
  employmentType        EmploymentType       @default(FULL_TIME)
  jobTitle              String
  startDate             DateTime             @db.Date
  contractedWeeklyHours Decimal              @db.Decimal(5, 2)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  organisation          Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  membership            Membership?          @relation("StaffMembership", fields: [membershipUserId, organisationId], references: [userId, organisationId], onDelete: Restrict)
  employmentRecords     EmploymentRecord[]
  careVisits            CareVisit[]
  shiftAssignments      ShiftAssignment[]
  // Phase 4
  availability          StaffAvailability[]
  absences              StaffAbsence[]
  schedulingOverrides   SchedulingOverride[]
  // Phase 5: Branch assignments
  branchAssignments     BranchAssignment[]

  @@unique([employeeNumber, organisationId])
  @@unique([id, organisationId])
  @@unique([membershipUserId, organisationId])
  @@index([organisationId, lastName, firstName])
  @@index([organisationId, employmentStatus])
  @@map("staff_profiles")
}

model EmploymentRecord {
  id             String         @id @default(uuid()) @db.Uuid
  organisationId String         @db.Uuid
  staffProfileId String         @db.Uuid
  title          String
  employmentType EmploymentType
  startDate      DateTime       @db.Date
  endDate        DateTime?      @db.Date
  weeklyHours    Decimal        @db.Decimal(5, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  staffProfile   StaffProfile   @relation(fields: [staffProfileId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@unique([staffProfileId, organisationId, startDate])
  @@index([organisationId, staffProfileId])
  @@map("employment_records")
}

model Invitation {
  id                    String       @id @default(uuid()) @db.Uuid
  organisationId        String       @db.Uuid
  invitedByMembershipId String       @db.Uuid
  email                 String
  role                  Role
  tokenHash             String       @unique
  expiresAt             DateTime
  acceptedAt            DateTime?
  createdAt             DateTime     @default(now())
  organisation          Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy             Membership   @relation("InvitedBy", fields: [invitedByMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@index([organisationId, email])
  @@map("invitations")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)

  @@index([windowStart])
  @@map("rate_limit_buckets")
}

model AuditLog {
  id                String       @id @default(uuid()) @db.Uuid
  organisationId    String       @db.Uuid
  actorUserId       String?      @db.Uuid
  actorMembershipId String?      @db.Uuid
  action            String
  entityType        String
  entityId          String?
  metadata          Json?
  createdAt         DateTime     @default(now())
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor             User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  membership        Membership?  @relation(fields: [actorMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@index([organisationId, createdAt])
  @@index([organisationId, entityType, entityId])
  @@map("audit_logs")
}

// =============================================================================
// Phase 2: Care Management Models
// =============================================================================

model Client {
  id                String             @id @default(uuid()) @db.Uuid
  organisationId    String             @db.Uuid
  clientReference   String
  firstName         String
  lastName          String
  preferredName     String?
  dateOfBirth       DateTime?          @db.Date
  email             String?
  phone             String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  postcode          String?
  careNotes         String?
  status            ClientStatus       @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organisation      Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  emergencyContacts EmergencyContact[]
  careVisits        CareVisit[]
  visitNotes        CareNote[]
  // Phase 3
  carePlans         CarePlan[]
  incidents         Incident[]

  @@unique([clientReference, organisationId])
  @@unique([id, organisationId])
  @@index([organisationId, status])
  @@index([organisationId, lastName, firstName])
  @@map("clients")
}

model EmergencyContact {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     String   @db.Uuid
  name         String
  relationship String
  phone        String
  email        String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("emergency_contacts")
}

model CareVisit {
  id                  String                @id @default(uuid()) @db.Uuid
  organisationId      String                @db.Uuid
  clientId            String                @db.Uuid
  staffProfileId      String?               @db.Uuid
  recurrenceId        String?               @db.Uuid
  scheduledDate       DateTime              @db.Date
  scheduledStart      DateTime              @db.Time
  scheduledEnd        DateTime              @db.Time
  actualStart         DateTime?
  actualEnd           DateTime?
  status              VisitStatus           @default(SCHEDULED)
  visitType           String?
  notes               String?
  cancellationNote    String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  organisation        Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client              Client                @relation(fields: [clientId, organisationId], references: [id, organisationId], onDelete: Restrict)
  staffProfile        StaffProfile?         @relation(fields: [staffProfileId, organisationId], references: [id, organisationId], onDelete: Restrict)
  recurrence          VisitRecurrence?      @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  careNotes           CareNote[]
  // Phase 3
  taskCompletions     VisitTaskCompletion[]
  incidents           Incident[]
  // Phase 4
  schedulingOverrides SchedulingOverride[]

  @@index([organisationId, scheduledDate])
  @@index([organisationId, clientId])
  @@index([organisationId, staffProfileId])
  @@index([organisationId, status])
  @@index([recurrenceId])
  @@map("care_visits")
}

model VisitRecurrence {
  id             String              @id @default(uuid()) @db.Uuid
  organisationId String              @db.Uuid
  clientId       String              @db.Uuid
  staffProfileId String?             @db.Uuid
  frequency      RecurrenceFrequency
  daysOfWeek     Int[]
  scheduledStart DateTime            @db.Time
  scheduledEnd   DateTime            @db.Time
  visitType      String?
  startDate      DateTime            @db.Date
  endDate        DateTime?           @db.Date
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  visits         CareVisit[]

  @@index([organisationId, isActive])
  @@index([organisationId, clientId])
  @@map("visit_recurrences")
}

model Shift {
  id                  String               @id @default(uuid()) @db.Uuid
  organisationId      String               @db.Uuid
  shiftReference      String
  locationName        String
  locationAddress     String?
  scheduledDate       DateTime             @db.Date
  scheduledStart      DateTime
  scheduledEnd        DateTime
  status              ShiftStatus          @default(SCHEDULED)
  notes               String?
  cancellationNote    String?
  isOvernight         Boolean              @default(false)
  recurrenceId        String?              @db.Uuid
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  organisation        Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  recurrence          ShiftRecurrence?     @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  assignments         ShiftAssignment[]
  careNotes           CareNote[]
  // Phase 4
  schedulingOverrides SchedulingOverride[]

  @@unique([shiftReference, organisationId])
  @@index([organisationId, scheduledDate])
  @@index([organisationId, status])
  @@index([recurrenceId])
  @@map("shifts")
}

model ShiftRecurrence {
  id              String              @id @default(uuid()) @db.Uuid
  organisationId  String              @db.Uuid
  locationName    String
  locationAddress String?
  frequency       RecurrenceFrequency
  daysOfWeek      Int[]
  scheduledStart  DateTime            @db.Time
  scheduledEnd    DateTime            @db.Time
  isOvernight     Boolean             @default(false)
  startDate       DateTime            @db.Date
  endDate         DateTime?           @db.Date
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  shifts          Shift[]

  @@index([organisationId, isActive])
  @@map("shift_recurrences")
}

model ShiftAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  shiftId        String       @db.Uuid
  organisationId String       @db.Uuid
  staffProfileId String       @db.Uuid
  actualStart    DateTime?
  actualEnd      DateTime?
  status         VisitStatus  @default(SCHEDULED)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  shift          Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staffProfile   StaffProfile @relation(fields: [staffProfileId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@unique([shiftId, staffProfileId])
  @@index([organisationId, staffProfileId])
  @@index([shiftId])
  @@map("shift_assignments")
}

model CareNote {
  id                 String       @id @default(uuid()) @db.Uuid
  organisationId     String       @db.Uuid
  visitId            String?      @db.Uuid
  shiftId            String?      @db.Uuid
  clientId           String?      @db.Uuid
  authorMembershipId String       @db.Uuid
  content            String
  isIncident         Boolean      @default(false)
  isPrivate          Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organisation       Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  visit              CareVisit?   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  shift              Shift?       @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  client             Client?      @relation(fields: [clientId, organisationId], references: [id, organisationId], onDelete: Cascade)
  authorMembership   Membership   @relation(fields: [authorMembershipId, organisationId], references: [id, organisationId], onDelete: Cascade)

  @@index([organisationId, visitId])
  @@index([organisationId, shiftId])
  @@index([organisationId, clientId])
  @@index([organisationId, isIncident])
  @@map("care_notes")
}

// =============================================================================
// Phase 3: Care Delivery Operations Models
// =============================================================================

model CarePlan {
  id                  String         @id @default(uuid()) @db.Uuid
  organisationId      String         @db.Uuid
  clientId            String         @db.Uuid
  title               String
  description         String?
  status              CarePlanStatus @default(DRAFT)
  startDate           DateTime       @db.Date
  reviewDate          DateTime?      @db.Date
  endDate             DateTime?      @db.Date
  specialInstructions String?
  isConfidential      Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  organisation        Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client              Client         @relation(fields: [clientId, organisationId], references: [id, organisationId], onDelete: Restrict)
  tasks               CarePlanTask[]

  @@index([organisationId, clientId])
  @@index([organisationId, status])
  @@index([organisationId, reviewDate])
  @@map("care_plans")
}

model CarePlanTask {
  id          String                @id @default(uuid()) @db.Uuid
  carePlanId  String                @db.Uuid
  title       String
  description String?
  frequency   TaskFrequency         @default(EVERY_VISIT)
  isRequired  Boolean               @default(true)
  sortOrder   Int                   @default(0)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  carePlan    CarePlan              @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  completions VisitTaskCompletion[]

  @@index([carePlanId, isActive])
  @@map("care_plan_tasks")
}

model VisitTaskCompletion {
  id               String       @id @default(uuid()) @db.Uuid
  visitId          String       @db.Uuid
  taskId           String       @db.Uuid
  completedById    String       @db.Uuid
  completed        Boolean      @default(false)
  unableToComplete Boolean      @default(false)
  notes            String?
  reason           String?
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  visit            CareVisit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  task             CarePlanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedBy      Membership   @relation(fields: [completedById], references: [id], onDelete: Restrict)

  @@unique([visitId, taskId])
  @@index([visitId])
  @@index([taskId])
  @@map("visit_task_completions")
}

model Incident {
  id                String           @id @default(uuid()) @db.Uuid
  organisationId    String           @db.Uuid
  incidentReference String
  clientId          String?          @db.Uuid
  visitId           String?          @db.Uuid
  reportedById      String           @db.Uuid
  reviewerId        String?          @db.Uuid
  category          IncidentCategory
  severity          IncidentSeverity @default(MEDIUM)
  status            IncidentStatus   @default(OPEN)
  occurredAt        DateTime
  location          String?
  description       String
  immediateAction   String?
  followUpRequired  Boolean          @default(false)
  followUpNotes     String?
  resolutionNotes   String?
  resolvedAt        DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  organisation      Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client            Client?          @relation(fields: [clientId, organisationId], references: [id, organisationId], onDelete: SetNull)
  visit             CareVisit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)
  reportedBy        Membership       @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  reviewer          Membership?      @relation("IncidentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([incidentReference, organisationId])
  @@index([organisationId, status])
  @@index([organisationId, category])
  @@index([organisationId, clientId])
  @@index([organisationId, reportedById])
  @@index([organisationId, reviewerId])
  @@index([organisationId, createdAt])
  @@map("incidents")
}

// =============================================================================
// Phase 4: Scheduling and Workforce Management Models
// =============================================================================

// Staff regular availability patterns
model StaffAvailability {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @db.Uuid
  staffProfileId String       @db.Uuid
  dayOfWeek      Int // 0=Sunday, 6=Saturday
  startTime      DateTime     @db.Time
  endTime        DateTime     @db.Time
  isPreferred    Boolean      @default(false)
  effectiveFrom  DateTime     @db.Date
  effectiveTo    DateTime?    @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  staffProfile   StaffProfile @relation(fields: [staffProfileId, organisationId], references: [id, organisationId], onDelete: Cascade)

  @@unique([staffProfileId, dayOfWeek, effectiveFrom])
  @@index([organisationId, staffProfileId])
  @@index([staffProfileId, dayOfWeek])
  @@map("staff_availability")
}

// Staff absences (leave, sickness, unavailable dates)
model StaffAbsence {
  id             String        @id @default(uuid()) @db.Uuid
  organisationId String        @db.Uuid
  staffProfileId String        @db.Uuid
  type           AbsenceType
  status         AbsenceStatus @default(PENDING)
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  startTime      DateTime?     @db.Time // For partial day absences
  endTime        DateTime?     @db.Time
  isFullDay      Boolean       @default(true)
  reason         String?
  notes          String?
  reviewedById   String?       @db.Uuid
  reviewedAt     DateTime?
  reviewNotes    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  staffProfile   StaffProfile  @relation(fields: [staffProfileId, organisationId], references: [id, organisationId], onDelete: Cascade)
  reviewedBy     Membership?   @relation("AbsenceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organisationId, staffProfileId])
  @@index([organisationId, status])
  @@index([organisationId, startDate, endDate])
  @@index([staffProfileId, startDate, endDate])
  @@map("staff_absences")
}

// Internal notifications
model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @db.Uuid
  recipientId    String           @db.Uuid // Membership ID
  type           NotificationType
  title          String
  message        String
  linkUrl        String?
  linkLabel      String?
  entityType     String?
  entityId       String?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  recipient      Membership       @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([organisationId, recipientId, isRead])
  @@index([recipientId, createdAt])
  @@index([organisationId, createdAt])
  @@map("notifications")
}

// Scheduling conflict overrides (when a conflict is acknowledged)
model SchedulingOverride {
  id              String       @id @default(uuid()) @db.Uuid
  organisationId  String       @db.Uuid
  visitId         String?      @db.Uuid
  shiftId         String?      @db.Uuid
  staffProfileId  String       @db.Uuid
  conflictType    ConflictType
  conflictDetails Json
  reason          String
  approvedById    String       @db.Uuid
  approvedAt      DateTime     @default(now())
  createdAt       DateTime     @default(now())
  visit           CareVisit?   @relation(fields: [visitId], references: [id], onDelete: Cascade)
  shift           Shift?       @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staffProfile    StaffProfile @relation(fields: [staffProfileId, organisationId], references: [id, organisationId], onDelete: Cascade)
  approvedBy      Membership   @relation(fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([organisationId, visitId])
  @@index([organisationId, shiftId])
  @@index([organisationId, staffProfileId])
  @@map("scheduling_overrides")
}

// Travel time estimates between locations (optional)
model TravelTimeEstimate {
  id               String       @id @default(uuid()) @db.Uuid
  organisationId   String       @db.Uuid
  fromPostcode     String
  toPostcode       String
  estimatedMinutes Int
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, fromPostcode, toPostcode])
  @@index([organisationId])
  @@map("travel_time_estimates")
}

// =============================================================================
// Phase 5: Multi-Organisation and Multi-Branch Models
// =============================================================================

// Branch within an organisation
model Branch {
  id               String             @id @default(uuid()) @db.Uuid
  organisationId   String             @db.Uuid
  name             String
  code             String // Unique within organisation
  status           BranchStatus       @default(ACTIVE)
  addressLine1     String?
  addressLine2     String?
  city             String?
  postcode         String?
  phone            String?
  email            String?
  serviceArea      String? // Geographic area served
  // CQC location ID if branch is a registered CQC location
  cqcLocationId    String?
  isHeadOffice     Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  organisation     Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  staffAssignments BranchAssignment[]

  @@unique([organisationId, code])
  @@index([organisationId, status])
  @@map("branches")
}

// Staff assignment to branches (many-to-many)
model BranchAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  branchId       String       @db.Uuid
  staffProfileId String       @db.Uuid
  organisationId String       @db.Uuid
  isPrimary      Boolean      @default(false) // Primary branch for the staff member
  role           String? // Optional role at this branch (e.g., "Branch Manager")
  startDate      DateTime     @db.Date
  endDate        DateTime?    @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staffProfile   StaffProfile @relation(fields: [staffProfileId, organisationId], references: [id, organisationId], onDelete: Cascade)

  @@unique([branchId, staffProfileId])
  @@index([organisationId, staffProfileId])
  @@index([branchId])
  @@map("branch_assignments")
}

// Platform-level organisation invitation (for onboarding new organisations)
model OrganisationInvitation {
  id                     String        @id @default(uuid()) @db.Uuid
  // Organisation details to be created
  organisationName       String
  tradingName            String?
  companyRegistrationNo  String?
  contactEmail           String
  contactPhone           String?
  registeredAddressLine1 String?
  registeredCity         String?
  registeredPostcode     String?
  // Initial administrator details
  primaryAdminName       String
  primaryAdminEmail      String
  // Token and status
  tokenHash              String        @unique
  expiresAt              DateTime
  acceptedAt             DateTime?
  // Reference to created organisation once accepted
  organisationId         String?       @db.Uuid
  organisation           Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  // Audit
  invitedByUserId        String        @db.Uuid
  invitedBy              User          @relation(fields: [invitedByUserId], references: [id], onDelete: Restrict)
  createdAt              DateTime      @default(now())

  @@index([contactEmail])
  @@index([primaryAdminEmail])
  @@index([expiresAt])
  @@map("organisation_invitations")
}

// Platform-level audit log (for cross-organisation actions by platform admins)
model PlatformAuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String   @db.Uuid
  action      String // e.g., "organisation.created", "organisation.suspended"
  entityType  String // e.g., "Organisation"
  entityId    String?
  targetOrgId String?  @db.Uuid // The organisation being acted upon
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetOrgId, createdAt])
  @@index([action, createdAt])
  @@map("platform_audit_logs")
}

// =============================================================================
// Phase 6: Hybrid Onboarding Models
// =============================================================================

// Public organisation applications (care companies applying to join platform)
model OrganisationApplication {
  id                     String            @id @default(uuid()) @db.Uuid
  // Company details
  companyName            String
  tradingName            String?
  companyRegistrationNo  String?
  registeredAddressLine1 String?
  registeredAddressLine2 String?
  registeredCity         String?
  registeredPostcode     String?
  // Primary contact
  primaryContactName     String
  primaryContactEmail    String
  primaryContactPhone    String?
  // Care services
  careServiceTypes       String[]          @default([])
  cqcRegistrationNo      String?
  estimatedStaffCount    Int?
  estimatedBranchCount   Int?
  // Application status workflow
  status                 ApplicationStatus @default(DRAFT)
  submittedAt            DateTime?
  // Review
  reviewedAt             DateTime?
  reviewedByUserId       String?           @db.Uuid
  reviewedBy             User?             @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewNotes            String?
  rejectionReason        String?
  // Provisioning (links to created organisation after approval)
  organisationId         String?           @db.Uuid
  organisation           Organisation?     @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  invitationId           String?           @db.Uuid
  // Consent
  privacyNoticeAccepted  Boolean           @default(false)
  termsAccepted          Boolean           @default(false)
  // Timestamps
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([status, submittedAt])
  @@index([primaryContactEmail])
  @@map("organisation_applications")
}

// Organisation onboarding progress tracking
model OrganisationOnboarding {
  id                String           @id @default(uuid()) @db.Uuid
  organisationId    String           @unique @db.Uuid
  organisation      Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  status            OnboardingStatus @default(INVITED)
  currentStep       Int              @default(0)
  completedSteps    Int[]            @default([])
  // Step completion flags
  profileCompleted  Boolean          @default(false)
  branchesCompleted Boolean          @default(false)
  servicesCompleted Boolean          @default(false)
  teamCompleted     Boolean          @default(false)
  reviewCompleted   Boolean          @default(false)
  // Timestamps
  lastStepAt        DateTime?
  completedAt       DateTime?
  activatedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("organisation_onboarding")
}

// =============================================================================
// Phase 7: Pilot Feedback Models
// =============================================================================

enum FeedbackSeverity {
  CRITICAL    // Blocks workflow, no workaround
  HIGH        // Major impact, workaround exists
  MEDIUM      // Moderate impact, usable
  LOW         // Minor inconvenience
  SUGGESTION  // Feature request or improvement
}

enum FeedbackStatus {
  NEW         // Just submitted
  TRIAGED     // Reviewed and prioritised
  IN_PROGRESS // Being worked on
  RESOLVED    // Fix deployed
  WONT_FIX    // Declined with reason
  DUPLICATE   // Duplicate of another issue
}

enum FeedbackCategory {
  BUG           // Something is broken
  USABILITY     // Difficult to use
  PERFORMANCE   // Slow or unresponsive
  SECURITY      // Security concern
  DATA          // Data issue or missing data
  FEATURE       // Missing feature
  DOCUMENTATION // Unclear or missing documentation
  OTHER         // Other feedback
}

// Pilot feedback submissions
model PilotFeedback {
  id               String            @id @default(uuid()) @db.Uuid
  // Organisation context (optional - platform admin feedback has no org)
  organisationId   String?           @db.Uuid
  organisation     Organisation?     @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  // Submitter
  submittedById    String            @db.Uuid
  submittedBy      User              @relation("FeedbackSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedByRole  Role
  // Feedback details
  category         FeedbackCategory
  severity         FeedbackSeverity
  status           FeedbackStatus    @default(NEW)
  // What feature or workflow
  featureArea      String            // e.g., "Staff Management", "Rota", "Onboarding"
  workflow         String?           // e.g., "Creating a new staff member"
  // Description
  title            String
  description      String
  reproductionSteps String?          // How to reproduce (for bugs)
  expectedBehavior String?           // What should happen
  actualBehavior   String?           // What actually happens
  // Browser/device info (captured automatically)
  browserInfo      String?
  screenResolution String?
  // Resolution
  resolution       String?
  resolvedAt       DateTime?
  resolvedById     String?           @db.Uuid
  resolvedBy       User?             @relation("FeedbackResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  // Related entities
  relatedEntityType String?          // e.g., "Client", "Visit", "StaffProfile"
  relatedEntityId  String?
  // Screenshots/attachments (URLs if uploaded)
  attachments      String[]          @default([])
  // Internal notes
  internalNotes    String?
  // Timestamps
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([organisationId, status])
  @@index([status, severity])
  @@index([category, status])
  @@index([submittedById])
  @@index([createdAt])
  @@map("pilot_feedback")
}
