generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  ORG_ADMIN
  MANAGER
  COORDINATOR
  CARE_WORKER
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  ZERO_HOURS
  CONTRACTOR
  TEMPORARY
}

// Phase 2: Care Management Enums

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum VisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  MISSED
  CANCELLED
}

enum ShiftStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

// Phase 3: Care Delivery Operations Enums

enum CarePlanStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  ARCHIVED
}

enum TaskFrequency {
  EVERY_VISIT
  DAILY
  WEEKLY
  MONTHLY
  AS_NEEDED
}

enum IncidentCategory {
  FALL
  MEDICATION_ERROR
  SAFEGUARDING
  BEHAVIOR
  EQUIPMENT
  MISSED_CARE
  HEALTH_CONCERN
  PROPERTY_DAMAGE
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

model Organisation {
  id            String             @id @default(uuid()) @db.Uuid
  name          String
  slug          String             @unique
  brandName     String?
  brandColour   String             @default("#0f766e")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  memberships   Membership[]
  staffProfiles StaffProfile[]
  employment    EmploymentRecord[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  clients       Client[]
  careVisits    CareVisit[]
  shifts        Shift[]
  careNotes     CareNote[]
  // Phase 3
  carePlans     CarePlan[]
  incidents     Incident[]

  @@map("organisations")
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  name                String
  email               String               @unique
  passwordHash        String
  emailVerified       DateTime?
  disabledAt          DateTime?
  sessionVersion      Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  memberships         Membership[]
  passwordResetTokens PasswordResetToken[]
  auditEvents         AuditLog[]

  @@map("users")
}

model Membership {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @db.Uuid
  organisationId       String                @db.Uuid
  role                 Role
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation         Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  staffProfiles        StaffProfile[]        @relation("StaffMembership")
  sentInvitations      Invitation[]          @relation("InvitedBy")
  auditLogs            AuditLog[]
  careNotes            CareNote[]
  // Phase 3
  taskCompletions      VisitTaskCompletion[]
  reportedIncidents    Incident[]            @relation("IncidentReporter")
  reviewingIncidents   Incident[]            @relation("IncidentReviewer")

  @@unique([userId, organisationId])
  @@unique([id, organisationId])
  @@index([organisationId, role, active])
  @@map("memberships")
}

model StaffProfile {
  id                    String             @id @default(uuid()) @db.Uuid
  organisationId        String             @db.Uuid
  membershipUserId      String?            @db.Uuid
  employeeNumber        String
  firstName             String
  lastName              String
  email                 String
  phone                 String?
  employmentStatus      EmploymentStatus   @default(ACTIVE)
  employmentType        EmploymentType     @default(FULL_TIME)
  jobTitle              String
  startDate             DateTime           @db.Date
  contractedWeeklyHours Decimal            @db.Decimal(5, 2)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  organisation          Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  membership            Membership?        @relation("StaffMembership", fields: [membershipUserId, organisationId], references: [userId, organisationId], onDelete: Restrict)
  employmentRecords     EmploymentRecord[]
  careVisits            CareVisit[]
  shiftAssignments      ShiftAssignment[]

  @@unique([employeeNumber, organisationId])
  @@unique([id, organisationId])
  @@unique([membershipUserId, organisationId])
  @@index([organisationId, lastName, firstName])
  @@index([organisationId, employmentStatus])
  @@map("staff_profiles")
}

model EmploymentRecord {
  id             String         @id @default(uuid()) @db.Uuid
  organisationId String         @db.Uuid
  staffProfileId String         @db.Uuid
  title          String
  employmentType EmploymentType
  startDate      DateTime       @db.Date
  endDate        DateTime?      @db.Date
  weeklyHours    Decimal        @db.Decimal(5, 2)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  staffProfile   StaffProfile   @relation(fields: [staffProfileId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@unique([staffProfileId, organisationId, startDate])
  @@index([organisationId, staffProfileId])
  @@map("employment_records")
}

model Invitation {
  id                    String       @id @default(uuid()) @db.Uuid
  organisationId        String       @db.Uuid
  invitedByMembershipId String       @db.Uuid
  email                 String
  role                  Role
  tokenHash             String       @unique
  expiresAt             DateTime
  acceptedAt            DateTime?
  createdAt             DateTime     @default(now())
  organisation          Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  invitedBy             Membership   @relation("InvitedBy", fields: [invitedByMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@index([organisationId, email])
  @@map("invitations")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)

  @@index([windowStart])
  @@map("rate_limit_buckets")
}

model AuditLog {
  id                String       @id @default(uuid()) @db.Uuid
  organisationId    String       @db.Uuid
  actorUserId       String?      @db.Uuid
  actorMembershipId String?      @db.Uuid
  action            String
  entityType        String
  entityId          String?
  metadata          Json?
  createdAt         DateTime     @default(now())
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor             User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  membership        Membership?  @relation(fields: [actorMembershipId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@index([organisationId, createdAt])
  @@index([organisationId, entityType, entityId])
  @@map("audit_logs")
}

// =============================================================================
// Phase 2: Care Management Models
// =============================================================================

model Client {
  id                String             @id @default(uuid()) @db.Uuid
  organisationId    String             @db.Uuid
  clientReference   String
  firstName         String
  lastName          String
  preferredName     String?
  dateOfBirth       DateTime?          @db.Date
  email             String?
  phone             String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  postcode          String?
  careNotes         String?
  status            ClientStatus       @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organisation      Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  emergencyContacts EmergencyContact[]
  careVisits        CareVisit[]
  visitNotes        CareNote[]
  // Phase 3
  carePlans         CarePlan[]
  incidents         Incident[]

  @@unique([clientReference, organisationId])
  @@unique([id, organisationId])
  @@index([organisationId, status])
  @@index([organisationId, lastName, firstName])
  @@map("clients")
}

model EmergencyContact {
  id           String   @id @default(uuid()) @db.Uuid
  clientId     String   @db.Uuid
  name         String
  relationship String
  phone        String
  email        String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("emergency_contacts")
}

model CareVisit {
  id               String               @id @default(uuid()) @db.Uuid
  organisationId   String               @db.Uuid
  clientId         String               @db.Uuid
  staffProfileId   String?              @db.Uuid
  recurrenceId     String?              @db.Uuid
  scheduledDate    DateTime             @db.Date
  scheduledStart   DateTime             @db.Time
  scheduledEnd     DateTime             @db.Time
  actualStart      DateTime?
  actualEnd        DateTime?
  status           VisitStatus          @default(SCHEDULED)
  visitType        String?
  notes            String?
  cancellationNote String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  organisation     Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client           Client               @relation(fields: [clientId, organisationId], references: [id, organisationId], onDelete: Restrict)
  staffProfile     StaffProfile?        @relation(fields: [staffProfileId, organisationId], references: [id, organisationId], onDelete: Restrict)
  recurrence       VisitRecurrence?     @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  careNotes        CareNote[]
  // Phase 3
  taskCompletions  VisitTaskCompletion[]
  incidents        Incident[]

  @@index([organisationId, scheduledDate])
  @@index([organisationId, clientId])
  @@index([organisationId, staffProfileId])
  @@index([organisationId, status])
  @@index([recurrenceId])
  @@map("care_visits")
}

model VisitRecurrence {
  id             String              @id @default(uuid()) @db.Uuid
  organisationId String              @db.Uuid
  clientId       String              @db.Uuid
  staffProfileId String?             @db.Uuid
  frequency      RecurrenceFrequency
  daysOfWeek     Int[]
  scheduledStart DateTime            @db.Time
  scheduledEnd   DateTime            @db.Time
  visitType      String?
  startDate      DateTime            @db.Date
  endDate        DateTime?           @db.Date
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  visits         CareVisit[]

  @@index([organisationId, isActive])
  @@index([organisationId, clientId])
  @@map("visit_recurrences")
}

model Shift {
  id               String            @id @default(uuid()) @db.Uuid
  organisationId   String            @db.Uuid
  shiftReference   String
  locationName     String
  locationAddress  String?
  scheduledDate    DateTime          @db.Date
  scheduledStart   DateTime
  scheduledEnd     DateTime
  status           ShiftStatus       @default(SCHEDULED)
  notes            String?
  cancellationNote String?
  isOvernight      Boolean           @default(false)
  recurrenceId     String?           @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organisation     Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  recurrence       ShiftRecurrence?  @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  assignments      ShiftAssignment[]
  careNotes        CareNote[]

  @@unique([shiftReference, organisationId])
  @@index([organisationId, scheduledDate])
  @@index([organisationId, status])
  @@index([recurrenceId])
  @@map("shifts")
}

model ShiftRecurrence {
  id              String              @id @default(uuid()) @db.Uuid
  organisationId  String              @db.Uuid
  locationName    String
  locationAddress String?
  frequency       RecurrenceFrequency
  daysOfWeek      Int[]
  scheduledStart  DateTime            @db.Time
  scheduledEnd    DateTime            @db.Time
  isOvernight     Boolean             @default(false)
  startDate       DateTime            @db.Date
  endDate         DateTime?           @db.Date
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  shifts          Shift[]

  @@index([organisationId, isActive])
  @@map("shift_recurrences")
}

model ShiftAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  shiftId        String       @db.Uuid
  organisationId String       @db.Uuid
  staffProfileId String       @db.Uuid
  actualStart    DateTime?
  actualEnd      DateTime?
  status         VisitStatus  @default(SCHEDULED)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  shift          Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staffProfile   StaffProfile @relation(fields: [staffProfileId, organisationId], references: [id, organisationId], onDelete: Restrict)

  @@unique([shiftId, staffProfileId])
  @@index([organisationId, staffProfileId])
  @@index([shiftId])
  @@map("shift_assignments")
}

model CareNote {
  id                   String      @id @default(uuid()) @db.Uuid
  organisationId       String      @db.Uuid
  visitId              String?     @db.Uuid
  shiftId              String?     @db.Uuid
  clientId             String?     @db.Uuid
  authorMembershipId   String      @db.Uuid
  content              String
  isIncident           Boolean     @default(false)
  isPrivate            Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  organisation         Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  visit                CareVisit?  @relation(fields: [visitId], references: [id], onDelete: Cascade)
  shift                Shift?      @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  client               Client?     @relation(fields: [clientId, organisationId], references: [id, organisationId], onDelete: Cascade)
  authorMembership     Membership  @relation(fields: [authorMembershipId, organisationId], references: [id, organisationId], onDelete: Cascade)

  @@index([organisationId, visitId])
  @@index([organisationId, shiftId])
  @@index([organisationId, clientId])
  @@index([organisationId, isIncident])
  @@map("care_notes")
}

// =============================================================================
// Phase 3: Care Delivery Operations Models
// =============================================================================

model CarePlan {
  id               String         @id @default(uuid()) @db.Uuid
  organisationId   String         @db.Uuid
  clientId         String         @db.Uuid
  title            String
  description      String?
  status           CarePlanStatus @default(DRAFT)
  startDate        DateTime       @db.Date
  reviewDate       DateTime?      @db.Date
  endDate          DateTime?      @db.Date
  specialInstructions String?
  isConfidential   Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  organisation     Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client           Client         @relation(fields: [clientId, organisationId], references: [id, organisationId], onDelete: Restrict)
  tasks            CarePlanTask[]

  @@index([organisationId, clientId])
  @@index([organisationId, status])
  @@index([organisationId, reviewDate])
  @@map("care_plans")
}

model CarePlanTask {
  id            String                @id @default(uuid()) @db.Uuid
  carePlanId    String                @db.Uuid
  title         String
  description   String?
  frequency     TaskFrequency         @default(EVERY_VISIT)
  isRequired    Boolean               @default(true)
  sortOrder     Int                   @default(0)
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  carePlan      CarePlan              @relation(fields: [carePlanId], references: [id], onDelete: Cascade)
  completions   VisitTaskCompletion[]

  @@index([carePlanId, isActive])
  @@map("care_plan_tasks")
}

model VisitTaskCompletion {
  id                String       @id @default(uuid()) @db.Uuid
  visitId           String       @db.Uuid
  taskId            String       @db.Uuid
  completedById     String       @db.Uuid
  completed         Boolean      @default(false)
  unableToComplete  Boolean      @default(false)
  notes             String?
  reason            String?
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  visit             CareVisit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  task              CarePlanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedBy       Membership   @relation(fields: [completedById], references: [id], onDelete: Restrict)

  @@unique([visitId, taskId])
  @@index([visitId])
  @@index([taskId])
  @@map("visit_task_completions")
}

model Incident {
  id               String           @id @default(uuid()) @db.Uuid
  organisationId   String           @db.Uuid
  incidentReference String
  clientId         String?          @db.Uuid
  visitId          String?          @db.Uuid
  reportedById     String           @db.Uuid
  reviewerId       String?          @db.Uuid
  category         IncidentCategory
  severity         IncidentSeverity @default(MEDIUM)
  status           IncidentStatus   @default(OPEN)
  occurredAt       DateTime
  location         String?
  description      String
  immediateAction  String?
  followUpRequired Boolean          @default(false)
  followUpNotes    String?
  resolutionNotes  String?
  resolvedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organisation     Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  client           Client?          @relation(fields: [clientId, organisationId], references: [id, organisationId], onDelete: SetNull)
  visit            CareVisit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)
  reportedBy       Membership       @relation("IncidentReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  reviewer         Membership?      @relation("IncidentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([incidentReference, organisationId])
  @@index([organisationId, status])
  @@index([organisationId, category])
  @@index([organisationId, clientId])
  @@index([organisationId, reportedById])
  @@index([organisationId, reviewerId])
  @@index([organisationId, createdAt])
  @@map("incidents")
}
