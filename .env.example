# The following non-functional URL is only for Prisma Client generation,
# schema validation and formatting. It must never be used for app runtime,
# migrations or seed operations. Set a real PostgreSQL URL for those operations.
DATABASE_URL=postgresql://placeholder:placeholder@127.0.0.1:5432/falconcare_placeholder?schema=public
# Local runtime services require real values when used; compilation does not.
NODE_ENV=development
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
APP_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM="FalconCare Hub <notifications@example.com>"
DEV_ADMIN_EMAIL=admin@falconcare.example.test
DEV_ADMIN_PASSWORD=replace-this-with-a-long-local-only-password
POSTGRES_DB=falconcare
POSTGRES_USER=falconcare
POSTGRES_PASSWORD=local-dev-only
