# FalconCare Hub - Database Migrator Image
# Dedicated image for running Prisma 6.19.3 migrations in Coolify.
#
# COOLIFY CONFIGURATION:
#   Build Pack:        Dockerfile
#   Dockerfile Path:   Dockerfile.migrator
#   Docker Context:    . (repository root)
#
# REQUIRED ENVIRONMENT VARIABLES (set in Coolify):
#   DATABASE_URL       PostgreSQL connection string from Coolify's internal network
#                      Example: postgresql://user:pass@falconcare-db:5432/falconcare?schema=public
#
# This image includes tsx and Prisma CLI 6.19.3 for migration operations.
# It does NOT run migrations automatically - use manual commands.
#
# Usage (in Coolify terminal or docker exec):
#   npm run db:status                              # Check migration status (read-only)
#   CONFIRM_DB_BACKUP=yes npm run db:migrate       # Apply pending migrations

FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

# -----------------------------------------------------------------------------
# Stage: deps - Install ALL dependencies including devDependencies
# -----------------------------------------------------------------------------
FROM base AS deps

# Copy package files
COPY package.json package-lock.json ./

# CRITICAL: Set NODE_ENV=development to ensure devDependencies (tsx, prisma) are installed
# npm ci respects NODE_ENV and skips devDependencies when NODE_ENV=production
ENV NODE_ENV=development

# Install all dependencies with exact versions from lockfile
RUN npm ci

# Verify tsx and prisma are installed with correct versions (fail fast if wrong)
RUN echo "=== Verifying dependencies ===" \
    && test -f node_modules/.bin/tsx || (echo "ERROR: tsx not found" && exit 1) \
    && test -f node_modules/.bin/prisma || (echo "ERROR: prisma not found" && exit 1) \
    && echo "tsx version:" && ./node_modules/.bin/tsx --version \
    && echo "prisma version:" && ./node_modules/.bin/prisma --version \
    && ./node_modules/.bin/prisma --version | grep -q "6.19.3" || (echo "ERROR: Prisma must be 6.19.3" && exit 1) \
    && echo "=== Dependencies verified ==="

# -----------------------------------------------------------------------------
# Stage: migrator - Final image with migrations
# -----------------------------------------------------------------------------
FROM base AS migrator
WORKDIR /app

# Runtime environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Copy node_modules from deps stage (includes tsx, prisma, dotenv)
COPY --from=deps /app/node_modules ./node_modules

# Copy package.json for npm scripts
COPY package.json ./

# Copy entire prisma directory (schema, migrations, seed)
COPY prisma ./prisma

# Copy Prisma config
COPY prisma.config.ts ./

# Copy migration wrapper script and its dependency
COPY scripts/database-operation.ts ./scripts/database-operation.ts
COPY src/lib/environment.ts ./src/lib/environment.ts

# Generate Prisma client for Alpine Linux (linux-musl-openssl-3.0.x)
# CRITICAL: Use local prisma from node_modules, NOT npx (which downloads latest version)
RUN ./node_modules/.bin/prisma generate

# Verify the image is correctly configured
RUN echo "=== Final verification ===" \
    && echo "Prisma CLI version:" && ./node_modules/.bin/prisma --version \
    && echo "tsx version:" && ./node_modules/.bin/tsx --version \
    && echo "Checking migrations directory:" \
    && ls -la prisma/migrations/ \
    && test -f prisma/migrations/migration_lock.toml || (echo "ERROR: migration_lock.toml missing" && exit 1) \
    && test -d prisma/migrations/20261010133000_sprint1_foundation || (echo "ERROR: Sprint1 migration missing" && exit 1) \
    && echo "npm ls prisma tsx:" && npm ls prisma tsx 2>/dev/null || true \
    && echo "=== Verification complete ==="

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 migrator \
    && chown -R migrator:nodejs /app

USER migrator

# Keep container running for manual migration commands
# Connect via Coolify terminal or: docker exec -it <container> sh
CMD ["sleep", "infinity"]
